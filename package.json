{
  "name": "cs2-faceit-comparison-tool",
  "version": "1.0.0",
  "description": "Head-to-head CS2 player comparison tool built on the FACEIT Data API",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "author": "Gasser Gadabdelkader",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
