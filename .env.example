# Copy to .env for local development. Never commit .env.

# Server-side key from https://developers.faceit.com/ (App Studio).
FACEIT_API_KEY=

PORT=3000
NODE_ENV=development

# Number of proxies in front of the app (1 on Render). Leave empty locally.
TRUST_PROXY=

# Optional tuning (defaults shown)
# MAX_MATCHES_PER_PLAYER=200
# COMPARE_RATE_LIMIT_PER_MINUTE=10
# GLOBAL_RATE_LIMIT_PER_MINUTE=120
# UPSTREAM_CONCURRENCY=4
# UPSTREAM_QUEUE_LIMIT=100
# UPSTREAM_TIMEOUT_MS=8000
# LOG_LEVEL=info
